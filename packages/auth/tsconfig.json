{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@bass/db": ["../db/src/index.ts"],
      "@bass/db/client": ["../db/src/client.ts"],
      "@bass/db/enums": ["../db/generated/prisma/enums.ts"],
      "@bass/db/types": ["../db/generated/prisma/client.ts"],
      "@bass/auth/*": ["../auth/src/*"],
      "@bass/core/*": ["../core/src/*"],
      "@bass/ui/*": ["../ui/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}

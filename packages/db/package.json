{
  "name": "@bass/db",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./enums": "./generated/prisma/enums.ts",
    "./env": "./src/env.ts",
    "./env-load": "./src/env-load.ts",
    "./types": "./generated/prisma/client.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "deploy": "prisma migrate deploy",
    "status": "prisma migrate status",
    "reset": "prisma migrate reset",
    "seed": "prisma db seed",
    "seed:demo": "node --conditions=react-server --import tsx prisma/seed-demo.ts",
    "studio": "prisma studio",
    "create-admin": "tsx scripts/create-admin.ts",
    "reindex": "node --conditions=react-server --import tsx scripts/reindex.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "pg": "^8.23.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "dotenv": "^17.4.2",
    "prisma": "7.10.0"
  }
}

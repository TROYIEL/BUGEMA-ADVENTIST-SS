// Bugema Adventist Secondary School (BASS)
// Prisma 7 schema. The datasource URL lives in prisma.config.ts, not here.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ===========================================================================
// Enums
// ===========================================================================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  ADMISSIONS_OFFICER
  CONTENT_EDITOR
  STAFF
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MediaVisibility {
  PUBLIC
  PRIVATE
}

enum StudyLevel {
  O_LEVEL
  A_LEVEL
  BOTH
}

enum Gender {
  MALE
  FEMALE
}

enum BoardingPreference {
  DAY
  BOARDING
  UNDECIDED
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  DOCUMENTS_REQUIRED
  SHORTLISTED
  ACCEPTED
  CONDITIONALLY_ACCEPTED
  REJECTED
  WITHDRAWN
}

enum ApplicationStep {
  APPLICANT
  GUARDIAN
  ACADEMIC
  ADDITIONAL
  DOCUMENTS
  REVIEW
}

enum DocumentVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  REPLACEMENT_REQUIRED
}

enum FormFieldType {
  TEXT
  TEXTAREA
  SELECT
  MULTISELECT
  RADIO
  CHECKBOX
  DATE
  NUMBER
  EMAIL
  PHONE
}

enum ActorType {
  APPLICANT
  STAFF
  SYSTEM
}

enum EnquiryStatus {
  UNREAD
  READ
  ARCHIVED
  SPAM
}

enum AnnouncementPlacement {
  GLOBAL
  HOMEPAGE
  ADMISSIONS
  ACADEMICS
}

enum NavigationMenu {
  HEADER
  FOOTER_PRIMARY
  FOOTER_SECONDARY
  UTILITY
  LEGAL
}

enum EmailStatus {
  QUEUED
  SENT
  FAILED
}

// ===========================================================================
// Auth, people, audit
// ===========================================================================

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         UserRole  @default(STAFF)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions            Session[]
  auditLogs           AuditLog[]
  authoredArticles    NewsArticle[]        @relation("ArticleAuthor")
  uploadedMedia       MediaAsset[]         @relation("MediaUploader")
  applicationNotes    ApplicationNote[]
  applicationEvents   ApplicationEvent[]
  reviewedDocuments   ApplicationDocument[] @relation("DocumentReviewer")
  decidedApplications Application[]        @relation("ApplicationDecider")
  sentMessages        ApplicationMessage[] @relation("MessageSender")
  handledEnquiries    ContactEnquiry[]     @relation("EnquiryHandler")
  staffProfile        StaffProfile?

  @@index([role])
  @@index([isActive])
  @@map("users")
}

// Server-side session store, so an admin session can be revoked immediately.
model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  oldValue    Json?
  newValue    Json?
  note        String?
  ipAddress   String?
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ===========================================================================
// Media
// ===========================================================================

model MediaAsset {
  id           String          @id @default(cuid())
  storageKey   String          @unique
  filename     String
  originalName String
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  blurDataUrl  String?
  alt          String?
  caption      String?
  folder       String          @default("uploads")
  visibility   MediaVisibility @default(PUBLIC)
  checksum     String?
  uploadedById String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  uploadedBy User? @relation("MediaUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  pageOgImages          Page[]                @relation("PageOgImage")
  featureMedia          HomeFeature[]         @relation("FeatureMedia")
  highlightMedia        HomeHighlight[]       @relation("HighlightMedia")
  heroSlideImages       HeroSlide[]           @relation("HeroSlideImage")
  heroSlideCollageOne   HeroSlide[]           @relation("HeroSlideCollageOne")
  heroSlideCollageTwo   HeroSlide[]           @relation("HeroSlideCollageTwo")
  heroSlideCollageThree HeroSlide[]           @relation("HeroSlideCollageThree")
  newsImages            NewsArticle[]         @relation("ArticleImage")
  eventImages           Event[]               @relation("EventImage")
  albumCovers           GalleryAlbum[]        @relation("AlbumCover")
  galleryImages         GalleryImage[]
  staffPhotos           StaffProfile[]
  departmentImages      AcademicDepartment[]
  programImages         AcademicProgram[]
  applicationDocuments  ApplicationDocument[]

  @@index([folder])
  @@index([visibility])
  @@index([checksum])
  @@index([createdAt])
  @@map("media_assets")
}

// ===========================================================================
// Site configuration
// ===========================================================================

// Grouped key/value settings. `isConfigured` is false for seeded placeholders,
// which is what drives the admin "Complete your site" checklist. The public
// site refuses to render an unconfigured value rather than inventing one.
model SiteSetting {
  id           String   @id @default(cuid())
  group        String
  key          String   @unique
  label        String
  description  String?
  value        Json
  isConfigured Boolean  @default(false)
  order        Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@index([group])
  @@map("site_settings")
}

model NavigationItem {
  id          String         @id @default(cuid())
  menu        NavigationMenu @default(HEADER)
  label       String
  href        String
  description String?
  parentId    String?
  order       Int            @default(0)
  isActive    Boolean        @default(true)
  highlight   Boolean        @default(false)
  opensInNewTab Boolean      @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  parent   NavigationItem?  @relation("NavigationChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children NavigationItem[] @relation("NavigationChildren")

  @@index([menu, order])
  @@index([parentId])
  @@map("navigation_items")
}

model Announcement {
  id        String                @id @default(cuid())
  title     String
  body      String?
  linkLabel String?
  linkHref  String?
  placement AnnouncementPlacement @default(GLOBAL)
  priority  Int                   @default(0)
  startsAt  DateTime?
  endsAt    DateTime?
  isActive  Boolean               @default(true)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@index([placement, isActive])
  @@index([startsAt, endsAt])
  @@map("announcements")
}

// ===========================================================================
// Pages
// ===========================================================================

model Page {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  subtitle       String?
  body           String?
  status         ContentStatus @default(DRAFT)
  isSystem       Boolean       @default(false)
  parentId       String?
  order          Int           @default(0)
  seoTitle       String?
  seoDescription String?
  ogImageId      String?
  canonicalUrl   String?
  noindex        Boolean       @default(false)
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  ogImage  MediaAsset?   @relation("PageOgImage", fields: [ogImageId], references: [id], onDelete: SetNull)
  parent   Page?         @relation("PageChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children Page[]        @relation("PageChildren")

  @@index([status, publishedAt])
  @@index([parentId])
  @@map("pages")
}

// ===========================================================================
// Homepage content
//
// The homepage LAYOUT is fixed in code: the order of the bands, and which band
// is which, is not something an administrator rearranges. What they do change
// is the content inside them — which is why these are ordinary typed rows
// rather than a generic section builder with an untyped JSON payload.
// ===========================================================================

/// A card in the "why choose the school" grid.
model HomeFeature {
  id        String   @id @default(cuid())
  title     String
  body      String
  mediaId   String?
  order     Int      @default(0)
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  media MediaAsset? @relation("FeatureMedia", fields: [mediaId], references: [id], onDelete: SetNull)

  @@index([isVisible, order])
  @@map("home_features")
}

/// An entry in the dark highlights band: a figure and what it refers to.
model HomeHighlight {
  id        String   @id @default(cuid())
  value     String
  label     String
  caption   String?
  mediaId   String?
  order     Int      @default(0)
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  media MediaAsset? @relation("HighlightMedia", fields: [mediaId], references: [id], onDelete: SetNull)

  @@index([isVisible, order])
  @@map("home_highlights")
}

/// One slide of the homepage hero carousel, composed by the school. Every
/// part is optional except the title; the public site renders whatever is
/// set. When no slide is active the site falls back to slides it builds
/// itself from settings, admissions and the latest content.
model HeroSlide {
  id                String    @id @default(cuid())
  title             String
  /// Small caps line above the title.
  subtitle          String?
  body              String?
  /// Short phrase set in oversized gold type beside the prints.
  displayText       String?
  ctaLabel          String?
  ctaHref           String?
  ctaSecondaryLabel String?
  ctaSecondaryHref  String?
  /// Lead with the school's telephone number as a "call now" action.
  showPhone         Boolean   @default(false)
  imageId           String?
  collageOneId      String?
  collageTwoId      String?
  collageThreeId    String?
  order             Int       @default(0)
  isActive          Boolean   @default(true)
  publishFrom       DateTime?
  publishUntil      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  image        MediaAsset? @relation("HeroSlideImage", fields: [imageId], references: [id], onDelete: SetNull)
  collageOne   MediaAsset? @relation("HeroSlideCollageOne", fields: [collageOneId], references: [id], onDelete: SetNull)
  collageTwo   MediaAsset? @relation("HeroSlideCollageTwo", fields: [collageTwoId], references: [id], onDelete: SetNull)
  collageThree MediaAsset? @relation("HeroSlideCollageThree", fields: [collageThreeId], references: [id], onDelete: SetNull)

  @@index([isActive, order])
  @@map("hero_slides")
}

// ===========================================================================
// News and events
// ===========================================================================

model NewsArticle {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String
  excerpt         String?
  body            String?
  featuredImageId String?
  authorId        String?
  category        String?
  status          ContentStatus @default(DRAFT)
  isFeatured      Boolean       @default(false)
  publishedAt     DateTime?
  seoTitle        String?
  seoDescription  String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  featuredImage MediaAsset? @relation("ArticleImage", fields: [featuredImageId], references: [id], onDelete: SetNull)
  author        User?       @relation("ArticleAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
  @@index([isFeatured])
  @@index([category])
  @@map("news_articles")
}

model Event {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String
  description     String?
  body            String?
  startDate       DateTime
  endDate         DateTime?
  startTime       String?
  endTime         String?
  location        String?
  imageId         String?
  registrationUrl String?
  status          ContentStatus @default(DRAFT)
  isFeatured      Boolean       @default(false)
  seoTitle        String?
  seoDescription  String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  image MediaAsset? @relation("EventImage", fields: [imageId], references: [id], onDelete: SetNull)

  @@index([status, startDate])
  @@index([isFeatured])
  @@map("events")
}

// ===========================================================================
// Gallery
// ===========================================================================

model GalleryAlbum {
  id           String        @id @default(cuid())
  slug         String        @unique
  title        String
  description  String?
  category     String?
  coverImageId String?
  status       ContentStatus @default(DRAFT)
  order        Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  coverImage MediaAsset?    @relation("AlbumCover", fields: [coverImageId], references: [id], onDelete: SetNull)
  images     GalleryImage[]

  @@index([status, order])
  @@map("gallery_albums")
}

model GalleryImage {
  id        String   @id @default(cuid())
  albumId   String
  mediaId   String
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  album GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  media MediaAsset   @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([albumId, mediaId])
  @@index([albumId, order])
  @@map("gallery_images")
}

// ===========================================================================
// Staff and academics
// ===========================================================================

model StaffProfile {
  id         String   @id @default(cuid())
  userId     String?  @unique
  name       String
  position   String
  department String?
  bio        String?
  email      String?
  phone      String?
  photoId    String?
  order      Int      @default(0)
  isVisible  Boolean  @default(true)
  isLeadership Boolean @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user  User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  photo MediaAsset? @relation(fields: [photoId], references: [id], onDelete: SetNull)

  headedDepartments AcademicDepartment[] @relation("DepartmentHead")
  taughtSubjects    Subject[]            @relation("SubjectTeacher")

  @@index([isVisible, order])
  @@index([isLeadership])
  @@map("staff_profiles")
}

model AcademicDepartment {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String?
  body        String?
  imageId     String?
  headId      String?
  order       Int           @default(0)
  status      ContentStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  image    MediaAsset?   @relation(fields: [imageId], references: [id], onDelete: SetNull)
  head     StaffProfile? @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)
  subjects Subject[]

  @@index([status, order])
  @@map("academic_departments")
}

model Subject {
  id           String        @id @default(cuid())
  slug         String        @unique
  name         String
  description  String?
  departmentId String?
  teacherId    String?
  level        StudyLevel    @default(BOTH)
  isCore       Boolean       @default(false)
  order        Int           @default(0)
  status       ContentStatus @default(DRAFT)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  department AcademicDepartment? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  teacher    StaffProfile?       @relation("SubjectTeacher", fields: [teacherId], references: [id], onDelete: SetNull)

  @@index([departmentId])
  @@index([level, status])
  @@map("subjects")
}

model AcademicProgram {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  level       StudyLevel    @default(BOTH)
  summary     String?
  body        String?
  imageId     String?
  order       Int           @default(0)
  status      ContentStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  image MediaAsset? @relation(fields: [imageId], references: [id], onDelete: SetNull)

  @@index([status, order])
  @@map("academic_programs")
}

// ===========================================================================
// Admissions configuration
// ===========================================================================

model AcademicYear {
  id                     String    @id @default(cuid())
  name                   String    @unique
  startDate              DateTime?
  endDate                DateTime?
  isActive               Boolean   @default(false)
  isAcceptingApplications Boolean  @default(false)
  applicationOpensAt     DateTime?
  applicationClosesAt    DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  applications Application[]

  @@index([isActive])
  @@map("academic_years")
}

model ApplicationClass {
  id       String     @id @default(cuid())
  name     String     @unique
  level    StudyLevel @default(O_LEVEL)
  order    Int        @default(0)
  isActive Boolean    @default(true)

  applications Application[]

  @@index([isActive, order])
  @@map("application_classes")
}

model AdmissionRequirement {
  id          String        @id @default(cuid())
  title       String
  description String?
  level       StudyLevel    @default(BOTH)
  order       Int           @default(0)
  status      ContentStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, order])
  @@map("admission_requirements")
}

// Which documents an applicant may/must upload. Nothing is mandatory unless
// the school explicitly sets isRequired.
model DocumentType {
  id                String     @id @default(cuid())
  name              String     @unique
  description       String?
  level             StudyLevel @default(BOTH)
  isRequired        Boolean    @default(false)
  acceptedMimeTypes String[]   @default(["image/jpeg", "image/png", "application/pdf"])
  maxSizeBytes      Int        @default(5242880)
  order             Int        @default(0)
  isActive          Boolean    @default(true)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  documents ApplicationDocument[]

  @@index([isActive, order])
  @@map("document_types")
}

// Admin-defined extra questions, answered into Application.answers.
model ApplicationFormField {
  id          String          @id @default(cuid())
  step        ApplicationStep @default(ADDITIONAL)
  key         String          @unique
  label       String
  helpText    String?
  fieldType   FormFieldType   @default(TEXT)
  options     Json            @default("[]")
  isRequired  Boolean         @default(false)
  order       Int             @default(0)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([step, order])
  @@map("application_form_fields")
}

// Atomic per-year sequence behind BASS-2026-000123.
model ApplicationCounter {
  year       Int      @id
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@map("application_counters")
}

// ===========================================================================
// Applications
// ===========================================================================

model Application {
  id              String            @id @default(cuid())
  // Assigned at submit, not at draft creation.
  referenceNumber String?           @unique
  // Resume-a-draft secret (hashed).
  draftTokenHash  String            @unique
  // Portal access secret issued on submit (hashed).
  accessTokenHash String?           @unique
  status          ApplicationStatus @default(DRAFT)
  currentStep     ApplicationStep   @default(APPLICANT)

  academicYearId     String
  applicationClassId String?
  boardingPreference BoardingPreference?

  // --- Applicant ---
  firstName    String?
  middleName   String?
  lastName     String?
  dateOfBirth  DateTime?
  gender       Gender?
  nationality  String?
  homeDistrict String?
  homeAddress  String?

  // --- Parent / guardian ---
  guardianName         String?
  guardianRelationship String?
  guardianPhone        String?
  guardianAltPhone     String?
  guardianEmail        String?
  guardianAddress      String?
  guardianOccupation   String?

  // --- Academic history ---
  previousSchool  String?
  previousClass   String?
  yearCompleted   Int?
  examIndexNumber String?
  examResults     String?

  // --- Admin-configured extra questions (ApplicationFormField.key -> answer) ---
  answers Json @default("{}")

  // Contact used for status notifications and the resume link.
  contactEmail String?
  contactPhone String?

  submittedAt DateTime?
  decisionAt  DateTime?
  decidedById String?
  lastSavedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  academicYear     AcademicYear      @relation(fields: [academicYearId], references: [id])
  applicationClass ApplicationClass? @relation(fields: [applicationClassId], references: [id], onDelete: SetNull)
  decidedBy        User?             @relation("ApplicationDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  documents ApplicationDocument[]
  events    ApplicationEvent[]
  notes     ApplicationNote[]
  messages  ApplicationMessage[]

  @@index([status, academicYearId])
  @@index([academicYearId, applicationClassId])
  @@index([submittedAt])
  @@index([lastName, firstName])
  @@index([firstName(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([lastName(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("applications")
}

model ApplicationDocument {
  id             String                     @id @default(cuid())
  applicationId  String
  documentTypeId String?
  mediaAssetId   String
  status         DocumentVerificationStatus @default(PENDING)
  reviewedById   String?
  reviewedAt     DateTime?
  note           String?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  application  Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  documentType DocumentType? @relation(fields: [documentTypeId], references: [id], onDelete: SetNull)
  mediaAsset   MediaAsset    @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  reviewedBy   User?         @relation("DocumentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([applicationId])
  @@index([status])
  @@map("application_documents")
}

// Immutable audit trail. isVisibleToApplicant controls whether the entry shows
// in the applicant portal timeline as well as the staff view.
model ApplicationEvent {
  id                 String    @id @default(cuid())
  applicationId      String
  action             String
  actorType          ActorType @default(SYSTEM)
  actorUserId        String?
  oldValue           String?
  newValue           String?
  note               String?
  isVisibleToApplicant Boolean @default(false)
  createdAt          DateTime  @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actor       User?       @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([applicationId, createdAt])
  @@map("application_events")
}

model ApplicationNote {
  id            String   @id @default(cuid())
  applicationId String
  authorId      String?
  body          String
  createdAt     DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  author      User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([applicationId, createdAt])
  @@map("application_notes")
}

model ApplicationMessage {
  id            String    @id @default(cuid())
  applicationId String
  subject       String
  body          String
  sentById      String?
  readAt        DateTime?
  createdAt     DateTime  @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  sentBy      User?       @relation("MessageSender", fields: [sentById], references: [id], onDelete: SetNull)

  @@index([applicationId, createdAt])
  @@map("application_messages")
}

// ===========================================================================
// Enquiries, email, search, rate limiting
// ===========================================================================

model ContactEnquiry {
  id          String        @id @default(cuid())
  name        String
  email       String
  phone       String?
  subject     String
  body        String
  status      EnquiryStatus @default(UNREAD)
  ipAddress   String?
  handledById String?
  readAt      DateTime?
  createdAt   DateTime      @default(now())

  handledBy User? @relation("EnquiryHandler", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("contact_enquiries")
}

// Every outgoing message is persisted first. With no SMTP configured this is
// the whole mail system, and the admin UI says so plainly.
model EmailOutbox {
  id          String      @id @default(cuid())
  toAddress   String
  toName      String?
  subject     String
  html        String
  text        String?
  status      EmailStatus @default(QUEUED)
  attempts    Int         @default(0)
  lastError   String?
  relatedType String?
  relatedId   String?
  sentAt      DateTime?
  createdAt   DateTime    @default(now())

  @@index([status, createdAt])
  @@map("email_outbox")
}

// Denormalised index for site search. `tsv` is a generated tsvector column
// added in a follow-up SQL migration (Prisma has no native tsvector type).
model SearchDocument {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  title      String
  excerpt    String?
  keywords   String?
  url        String
  updatedAt  DateTime @updatedAt

  // Generated column, populated by Postgres (see the search_tsvector
  // migration). Declared here so `migrate dev` does not drop it; it is never
  // written by the client and is queried through $queryRaw.
  tsv Unsupported("tsvector")?

  @@unique([entityType, entityId])
  @@index([entityType])
  @@index([tsv], type: Gin)
  @@map("search_documents")
}

model RateLimit {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())
  expiresAt   DateTime

  @@index([expiresAt])
  @@map("rate_limits")
}

{
  "name": "bass-admin",
  "version": "1.0.0",
  "private": true,
  "description": "Bugema Adventist Secondary School - administration system and database owner",
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --conditions=react-server --import tsx --test \"src/**/*.test.ts\"",
    "test:e2e": "node scripts/e2e/run.mjs",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:reset": "prisma migrate reset",
    "db:seed": "prisma db seed",
    "db:seed:demo": "node --conditions=react-server --import tsx prisma/seed-demo.ts",
    "db:studio": "prisma studio",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "create-admin": "tsx scripts/create-admin.ts",
    "search:reindex": "node --conditions=react-server --import tsx scripts/reindex.ts",
    "mail:flush": "node --conditions=react-server --import tsx scripts/flush-mail.ts",
    "storage:push": "node --conditions=react-server --import tsx scripts/storage-push.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1132.0",
    "@neon/config": "^1.4.2",
    "@neon/env": "^1.3.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.47.0",
    "next": "16.3.4",
    "nodemailer": "^10.0.3",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "^2.17.7",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.1",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "prisma": "7.10.0",
    "puppeteer-core": "^25.11.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}

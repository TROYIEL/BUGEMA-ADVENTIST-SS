# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. `.env` is gitignored; this file is committed.
# This project owns the database: migrations, seed and the CLI scripts run
# from here. The public website is a separate project with its own .env that
# points at the same database and the same file storage.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Either a local PostgreSQL in Docker (`npm run db:up`; these match
# docker-compose.yml) ...
POSTGRES_USER=bass
POSTGRES_PASSWORD=bass_dev_password
POSTGRES_DB=bass
POSTGRES_PORT=5432
DATABASE_URL="postgresql://bass:bass_dev_password@localhost:5432/bass?schema=public"

# ... or a hosted one such as Neon. Then DATABASE_URL is the *pooled*
# connection string (the "-pooler" host) for the app, and
# DATABASE_URL_UNPOOLED the direct one, which migrations and the CLI scripts
# use when it is set. Neon's CLI writes these itself (`neon env pull`).
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full"
# DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=verify-full"

# --- Site ------------------------------------------------------------------
# Absolute origin of the PUBLIC WEBSITE, no trailing slash. The links inside
# outgoing email (status updates, portal links) point there.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- File storage ----------------------------------------------------------
# "local" writes to STORAGE_LOCAL_DIR on this machine — fine for a single
# server or VPS. "s3" uses any S3-compatible object store (AWS S3, Cloudflare
# R2, Neon Object Storage, MinIO) and is what a hosted deploy needs, since a
# platform like Vercel has no persistent disk.
STORAGE_DRIVER=local
# Relative paths are resolved against THIS project's root. The website must
# read the same files, so when both projects run on one machine with the
# local driver, give both the SAME ABSOLUTE PATH here (or use S3).
STORAGE_LOCAL_DIR=storage

# Only read when STORAGE_DRIVER=s3.
# STORAGE_S3_BUCKET=bass-media
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
# For AWS leave the endpoint unset and set the region. For anything else set
# the provider's endpoint; the region can stay "auto".
# STORAGE_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# STORAGE_S3_REGION=auto
# STORAGE_S3_FORCE_PATH_STYLE=true

# --- Email -----------------------------------------------------------------
# Leave MAIL_DRIVER unset or "outbox" to queue mail to the database without
# sending. The dashboard shows queued mail plainly rather than claiming it sent.
#   outbox  - store only (default; safe for development)
#   console - store + print to the server log
#   smtp    - store + deliver via the SMTP settings below
MAIL_DRIVER=outbox
MAIL_FROM_NAME="Bugema Adventist Secondary School"
MAIL_FROM_ADDRESS=no-reply@example.invalid
# Address that receives "new application" / "new enquiry" notifications.
MAIL_ADMIN_NOTIFICATIONS=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Mail is attempted once when it is created. Anything that fails (or was
# queued while SMTP was unconfigured) is retried by `npm run mail:flush` from
# cron on a server, or by a scheduler calling
#   GET /api/cron/mail   with header   Authorization: Bearer $CRON_SECRET
# The endpoint answers 404 until this is set. Generate with: openssl rand -hex 32
CRON_SECRET=

# --- CLI -------------------------------------------------------------------
# `npm run create-admin -- --password-from-env` reads the password from here
# so it never appears in argv or shell history.
# BASS_ADMIN_PASSWORD=

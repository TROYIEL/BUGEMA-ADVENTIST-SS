{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@bass/db": ["../../packages/db/src/index.ts"],
      "@bass/db/client": ["../../packages/db/src/client.ts"],
      "@bass/db/enums": ["../../packages/db/generated/prisma/enums.ts"],
      "@bass/db/types": ["../../packages/db/generated/prisma/client.ts"],
      "@bass/auth/*": ["../../packages/auth/src/*"],
      "@bass/core/*": ["../../packages/core/src/*"],
      "@bass/ui/*": ["../../packages/ui/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}

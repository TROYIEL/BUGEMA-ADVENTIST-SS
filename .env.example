# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. `.env` is gitignored; this file is committed.
# ---------------------------------------------------------------------------

# --- Database (matches docker-compose.yml) ---------------------------------
POSTGRES_USER=bass
POSTGRES_PASSWORD=bass_dev_password
POSTGRES_DB=bass
POSTGRES_PORT=5432
DATABASE_URL="postgresql://bass:bass_dev_password@localhost:5432/bass?schema=public"

# --- Sessions --------------------------------------------------------------
# REQUIRED. Generate with: openssl rand -base64 32
# Signs applicant portal cookies. Rotating it signs every applicant out; admin
# sessions are stored in the database and are unaffected.
SESSION_SECRET=

# --- Site ------------------------------------------------------------------
# Absolute origin, no trailing slash. Used for canonical URLs, OG tags,
# sitemap.xml and the links inside outgoing email.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- File storage ----------------------------------------------------------
# "local" writes to STORAGE_LOCAL_DIR. "s3" is a stub; see src/lib/storage.
STORAGE_DRIVER=local
# Relative paths are resolved against the repository root, never the working
# directory, so both apps and the CLI scripts share one storage directory.
STORAGE_LOCAL_DIR=storage

# --- Email -----------------------------------------------------------------
# Leave MAIL_DRIVER unset or "outbox" to queue mail to the database without
# sending. The admin UI shows queued mail plainly rather than claiming it sent.
#   outbox  - store only (default; safe for development)
#   console - store + print to the server log
#   smtp    - store + deliver via the SMTP settings below
MAIL_DRIVER=outbox
MAIL_FROM_NAME="Bugema Adventist Secondary School"
MAIL_FROM_ADDRESS=no-reply@example.invalid
# Address that receives "new application" / "new enquiry" notifications.
MAIL_ADMIN_NOTIFICATIONS=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

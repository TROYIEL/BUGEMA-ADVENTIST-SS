# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. `.env` is gitignored; this file is committed.
# The database is created, migrated and seeded by the administration project;
# this one connects to the same database and the same file storage.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# The same database the administration project uses. A local PostgreSQL ...
DATABASE_URL="postgresql://bass:bass_dev_password@localhost:5432/bass?schema=public"

# ... or a hosted one such as Neon, where DATABASE_URL is the *pooled*
# connection string (the "-pooler" host).
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full"

# --- Sessions --------------------------------------------------------------
# REQUIRED. Generate with: openssl rand -base64 32
# Signs applicant draft and portal cookies. Rotating it signs every applicant
# out.
SESSION_SECRET=

# --- Site ------------------------------------------------------------------
# Absolute origin of this site, no trailing slash. Used for canonical URLs,
# OG tags, sitemap.xml and the links inside outgoing email.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- File storage ----------------------------------------------------------
# Must match the administration project: it uploads the media this site
# shows, and this site stores the documents applicants upload for it to
# review. "local" writes to STORAGE_LOCAL_DIR on this machine; "s3" uses any
# S3-compatible object store and is what a hosted deploy needs.
STORAGE_DRIVER=local
# Relative paths are resolved against THIS project's root. When both projects
# run on one machine with the local driver, give both the SAME ABSOLUTE PATH
# here (or use S3).
STORAGE_LOCAL_DIR=storage

# Only read when STORAGE_DRIVER=s3. The bucket must already exist.
# STORAGE_S3_BUCKET=storage
#
# Credentials, endpoint and region: EITHER paste the AWS-standard block a
# provider hands out (Neon Object Storage's dashboard and `neon env pull`
# write exactly these names) ...
# AWS_ENDPOINT_URL_S3=https://<branch>.storage.<region>.aws.neon.tech
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=eu-central-1
#
# ... OR use this project's own names, which win when both are present. For
# AWS S3 itself leave the endpoint unset; the region can stay "auto" elsewhere.
# STORAGE_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
# STORAGE_S3_REGION=auto
# STORAGE_S3_FORCE_PATH_STYLE=true
# Use the same bucket and credentials as the administration project.

# --- Email -----------------------------------------------------------------
# Application confirmations, resume links, portal links and enquiry
# notifications are sent from here. Leave MAIL_DRIVER unset or "outbox" to
# queue mail to the database without sending; the administration project's
# `mail:flush` delivers the queue once SMTP is configured.
#   outbox  - store only (default; safe for development)
#   console - store + print to the server log
#   smtp    - store + deliver via the SMTP settings below
MAIL_DRIVER=outbox
MAIL_FROM_NAME="Bugema Adventist Secondary School"
MAIL_FROM_ADDRESS=no-reply@example.invalid
# Address that receives "new application" / "new enquiry" notifications.
MAIL_ADMIN_NOTIFICATIONS=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
